laboratories -- r4 [taillabel="0..1", labeldistance=1.35, labelangle=25];
r4 -- transactions [headlabel="0..N", labeldistance=1.35, labelangle=25];
r5 [shape=diamond, label="destination", width=1.18, height=0.72, fontsize=10, margin="0.04,0.02"];

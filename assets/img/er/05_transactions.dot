transactions_9 [shape=ellipse, label=<transaction_date>, fontsize=10, margin="0.09,0.05"];
transactions -- transactions_9 [color="#777777", penwidth=0.85];
equipment [shape=box, label="Equipment", width=1.55, height=0.62, penwidth=1.7];
equipment_0 [shape=ellipse, label=<<U>equipment_id</U>>, fontsize=10, margin="0.09,0.05"];
equipment -- equipment_0 [color="#777777", penwidth=0.85];
equipment_1 [shape=ellipse, label=<asset_tag (UK)>, fontsize=10, margin="0.09,0.05"];
equipment -- equipment_1 [color="#777777", penwidth=0.85];
consumables [shape=box, label="Consumables", width=1.55, height=0.62, penwidth=1.7];
consumables_0 [shape=ellipse, label=<<U>consumable_id</U>>, fontsize=10, margin="0.09,0.05"];
consumables -- consumables_0 [color="#777777", penwidth=0.85];
consumables_1 [shape=ellipse, label=<item_code (UK)>, fontsize=10, margin="0.09,0.05"];
